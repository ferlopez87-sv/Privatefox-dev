<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Re-installs policies.json after Firefox auto-updates (macOS replaces
    the whole .app bundle, wiping Contents/Resources/distribution).
    WatchPaths fires when the bundle changes; the guard script waits for
    Gatekeeper's first-launch validation before re-copying, then leaves a
    note that a Firefox restart is needed.

    __FIREFOX_WATCH_PATHS__ is filled in by scripts/install.ts with one
    <string> per detected Firefox install. It used to be a hardcoded
    /Applications/Firefox.app path, which meant the guard never fired for
    anyone on Developer Edition, Nightly or ESR — exactly the case it was
    written to protect.
  -->
  <key>Label</key>
  <string>com.privatefox.policyguard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOST_BINARY_PATH__</string>
    <string>--policy-guard</string>
  </array>
  <key>WatchPaths</key>
  <array>
__FIREFOX_WATCH_PATHS__
  </array>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/privatefox-policyguard.log</string>
</dict>
</plist>
